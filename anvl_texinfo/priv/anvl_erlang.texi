@ifclear ERLNAMESPACE
@set ERLNAMESPACE
@end ifclear

@ifinfo
@macro erlref{MODULE,FUNCTION,ARITY}
    @code{\MODULE\/\FUNCTION\/\ARITY\}
@end macro
@end ifinfo

@ifnotinfo
@macro erlref{MODULE,FUNCTION,ARITY}
  @code{\MODULE\:\FUNCTION\/\ARITY\}
@end macro
@end ifnotinfo

@macro erlcall{MODULE,FUNCTION,ARITY}
\MODULE\:\FUNCTION\
@end macro

@macro erllcall{MODULE,FUNCTION,ARITY}
\FUNCTION\
@end macro

@macro erlfunlike{OUTER, INNER, CATEGORY, MODULE, FUNCTION, ARITY}
@\OUTER\{\FUNCTION\/\ARITY\ \MODULE\ @value{ERLNAMESPACE} \CATEGORY\,@\INNER\{\MODULE\,\FUNCTION\,\ARITY\}}
@end macro

@macro erlfn{OUTER, INNER, MODULE, FUNCTION, ARITY}
@erlfunlike{\OUTER\,\INNER\,Function,\MODULE\,\FUNCTION\,\ARITY\}
@end macro

@macro erltp{OUTER, INNER, MODULE, FUNCTION, ARITY}
@erlfunlike{\OUTER\,\INNER\,Type,\MODULE\,\FUNCTION\,\ARITY\}
@end macro

@macro erlcb{OUTER, INNER, MODULE, FUNCTION, ARITY}
@erlfunlike{\OUTER\,\INNER\,Callback,\MODULE\,\FUNCTION\,\ARITY\}
@end macro

@macro erlmodref{OUTER, MODULE}
@\OUTER\{\MODULE\ @value{ERLNAMESPACE} Module,@code{\MODULE\}}
@end macro
